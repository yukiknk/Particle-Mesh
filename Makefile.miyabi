# Miyabi-G 用（NVIDIA HPC SDK 25.9 + HPC-X）
CXX = mpicxx
FC  = mpifort

FFTW_DIR    = /work/opt/local/aarch64/apps/nvidia/25.9/fftw/3.3.10
MPIFFTW_DIR = /work/opt/local/aarch64/apps/nvidia/25.9/nv-hpcx/25.9/mpi-fftw/3.3.10

CXXFLAGS = -fast -mp -std=c++17 -I./include -I$(FFTW_DIR)/include -I$(MPIFFTW_DIR)/include
FFLAGS   = -fast -mp

LIBS = -L$(MPIFFTW_DIR)/lib -L$(FFTW_DIR)/lib \
       -Wl,-rpath,$(MPIFFTW_DIR)/lib,-rpath,$(FFTW_DIR)/lib \
       -lfftw3_mpi -lfftw3_omp -lfftw3 -lm \
       -fortranlibs -lmpi_mpifh

TARGET = pm_fft_test

SRCS = src/main.cpp \
       src/interpolater.cpp \
       src/grouping.cpp \
       src/fft/fft_fftw.cpp \
       src/fft/fft_ffte1.cpp \
       src/fft/fft_ffte2.cpp \
       src/transpose/transpose_fwd_slab.cpp \
       src/transpose/transpose_bwd_slab.cpp \
       src/transpose/transpose_fwd_pencil.cpp \
       src/transpose/transpose_bwd_pencil.cpp

FSRCS = src/fft/factor.f \
        src/fft/fft235.f \
        src/fft/kernel.f \
        src/fft/pdzfft3d.f \
        src/fft/pzdfft3d.f \
        src/fft/pdzfft3dv.f \
        src/fft/pzdfft3dv.f

# ---- heFFTe (GPU, CUDA 13.0) ----
HEFFTE_DIR = /work/gu99/u99001/opt/heffte
HEFFTE_LIB = $(firstword $(wildcard $(HEFFTE_DIR)/lib64 $(HEFFTE_DIR)/lib))
CUDA_DIR   = $(or $(NVHPC_CUDA_HOME),/work/opt/local/aarch64/cores/nvidia/25.9/Linux_aarch64/25.9/cuda/13.0)
CUDA_INC   = $(firstword $(wildcard $(CUDA_DIR)/include $(CUDA_DIR)/targets/sbsa-linux/include))
CUDA_LIB   = $(firstword $(wildcard $(CUDA_DIR)/lib64 $(CUDA_DIR)/targets/sbsa-linux/lib))
NVHPC_DIR  = $(or $(NVHPC_ROOT),/work/opt/local/aarch64/cores/nvidia/25.9/Linux_aarch64/25.9)
MATH_LIB   = $(firstword $(wildcard $(NVHPC_DIR)/math_libs/13.0/lib64 $(NVHPC_DIR)/math_libs/lib64))

CXXFLAGS += -DUSE_HEFFTE -I$(HEFFTE_DIR)/include -I$(CUDA_INC)
LIBS     += -L$(HEFFTE_LIB) -L$(MATH_LIB) -L$(CUDA_LIB) \
            -Wl,-rpath,$(HEFFTE_LIB),-rpath,$(MATH_LIB),-rpath,$(CUDA_LIB) \
            -lheffte -lcufft -lcudart
SRCS     += src/fft/fft_heffte.cpp

CPP_OBJS = $(SRCS:.cpp=.o)
F_OBJS   = $(FSRCS:.f=.o)
OBJS     = $(CPP_OBJS) $(F_OBJS)

all: $(TARGET)

$(TARGET): $(OBJS)
	$(CXX) $(CXXFLAGS) -o $(TARGET) $(OBJS) $(LIBS)

%.o: %.cpp
	$(CXX) $(CXXFLAGS) -c $< -o $@

%.o: %.f
	$(FC) $(FFLAGS) -c $< -o $@

clean:
	rm -f $(OBJS) $(TARGET)

.PHONY: all clean